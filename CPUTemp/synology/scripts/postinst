#!/bin/sh
#----------------------------------------------------------
# Runs after package install/upgrade.
#----------------------------------------------------------

PKG_NAME="CPUTemp"
PKG_DEST="/var/packages/${PKG_NAME}/target"
PKG_VAR="/var/packages/${PKG_NAME}/var"

chmod 755 "${PKG_DEST}/bin/syno_cpu_temp.sh"
chmod 755 "${PKG_DEST}/bin/cpu_temp_api.sh"
chmod 755 "${PKG_DEST}/bin/task_setup.sh"
chmod 755 "${PKG_DEST}/ui/api.cgi"

mkdir -p "${PKG_VAR}"

# Sudoers grant so api.cgi (running as the package's own service
# account) can invoke cpu_temp_api.sh as root via `sudo -n`.
# cpu_temp_api.sh in turn calls task_setup.sh directly (already root
# by that point, no separate sudo needed there).
# Mirrors the SourceManager sudoers.d pattern.
SUDOERS_FILE="/etc/sudoers.d/${PKG_NAME}"
cat > "${SUDOERS_FILE}" <<EOF
${PKG_NAME} ALL=(root) NOPASSWD: ${PKG_DEST}/bin/cpu_temp_api.sh run
${PKG_NAME} ALL=(root) NOPASSWD: ${PKG_DEST}/bin/cpu_temp_api.sh getlog
${PKG_NAME} ALL=(root) NOPASSWD: ${PKG_DEST}/bin/cpu_temp_api.sh getsettings
${PKG_NAME} ALL=(root) NOPASSWD: ${PKG_DEST}/bin/cpu_temp_api.sh setsettings *
EOF
chmod 440 "${SUDOERS_FILE}"

exit 0
